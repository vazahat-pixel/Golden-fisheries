NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/golden_fisheries

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS — Fast2SMS
SMS_API_KEY=
SMS_GATEWAY_URL=https://www.fast2sms.com/dev/bulkV2
SMS_FORCE_SEND=false
SMS_SENDER_ID=

# WhatsApp — Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=in
